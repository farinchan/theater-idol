APP_NAME="Theater Idol"
SITE_URL="https://theater-idol.web.id"

# Live Streaming
STREAM_URL="https://your-stream-url.m3u8"
STREAM_USE_PROXY=true
STREAM_PROXY_ORIGIN="https://stream.your-domain.com"

# Appwrite Configuration
APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your_project_id"
APPWRITE_PROJECT_NAME="Theater Idol"
APPWRITE_API_KEY="your_appwrite_api_key"

# Appwrite Database & Collections / Tables
APPWRITE_DATABASE_ID="your_database_id"
APPWRITE_TABLE_SETLIST_ID="your_setlist_table_id"
APPWRITE_TABLE_SHOW_ID="shows"
APPWRITE_TABLE_CHAT_ID="live_chat"
APPWRITE_COLLECTION_SETLIST_ID="your_setlist_table_id"
APPWRITE_BUCKET_ID="setlist-photos"

# Payment Gateway (Server-Only Secrets)
SUMOPOD_API_KEY="your_api_key_here"
SUMOPOD_PAY_ENDPOINT="https://api-pay-sandbox.sumopod.com/api/v1/payments"
SUMOPOD_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
SUMOPOD_WEBHOOK_TOKEN="whtok_your_webhook_token_here"
